DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boutique_saas?schema=public"

# Signe les jetons de session. Obligatoire : sans lui, le serveur refuse de démarrer.
# La valeur ci-dessous est un marqueur volontairement rejeté au démarrage — elle est publiée
# dans le dépôt, donc inutilisable. Génère la tienne avec :
#     openssl rand -base64 48
JWT_SECRET="change-me-in-production"
# Durée de validité d'une session. Un employé désactivé perd son accès immédiatement
# (l'utilisateur est relu en base à chaque requête), cette durée ne gouverne que le confort.
JWT_EXPIRES_IN="7d"
PORT=3001
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# Non renseignée, la valeur par défaut est http://localhost:3000 (le frontend en local) :
# pense à mettre l'URL réelle du frontend en production, sinon il sera bloqué.
CORS_ORIGINS="http://localhost:3000"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Secret opérateur : confirme manuellement qu'un paiement d'abonnement a été reçu.
# JAMAIS partagé avec un tenant. Génère une valeur aléatoire longue et garde-la pour toi seul.
PLATFORM_ADMIN_SECRET="change-me-to-a-long-random-value"
